# Copy to .env and customize -- `docker compose` loads it automatically.
#
# This file only lists settings worth reviewing for YOUR deployment.
# Everything else (timeouts, browser settings, per-skill on/off switches,
# local LLM model pins, etc.) already has a sensible default baked into
# docker-compose.yml's ADVANCED / SKILL TOGGLES sections -- add a line here
# only if you actually want to override one of those too.

# Your SearXNG instance. Must be reachable from inside the container --
# a LAN IP (not "localhost") works regardless of which machine runs this.
SEARXNG_URL=http://searxng.local:8080

# Local LLM bridge (ask_local_llm) -- LM Studio / MLX servers started via
# lmstudio_server.sh / mlx_server.sh. host.docker.internal only works if
# those run on the SAME machine as this container. If they run elsewhere
# (e.g. your Mac, while this container runs on a separate LAN box), use
# that machine's actual LAN IP instead -- see README's "Running it" section.
LMSTUDIO_URL=http://host.docker.internal:1234/v1
MLX_URL=http://host.docker.internal:8080/v1

# Optional: attribute git_commit's commits to you instead of the generic
# default. Leave commented out to skip this.
#GIT_AUTHOR_NAME=Your Name
#GIT_AUTHOR_EMAIL=you@example.com
#GIT_COMMITTER_NAME=Your Name
#GIT_COMMITTER_EMAIL=you@example.com
